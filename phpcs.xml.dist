<?xml version="1.0"?>
<ruleset name="Outbound UTM Tagger">
	<description>WordPress coding standards for Outbound UTM Tagger.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<!-- Keep in sync with the plugin header + readme.txt. -->
	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="8.0-"/>

	<!-- Alignment/formatting warnings are auto-fixable and shouldn't fail CI. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<!-- WordPress-Extra = Core + best-practices + security, WITHOUT the docblock-heavy
	     WordPress-Docs sniffs (which WP.org does not require). -->
	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="local-pr-outbound-utm-tagger"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="outbound_utm"/>
				<element value="Outbound_UTM"/>
				<element value="OUTBOUND_UTM"/>
			</property>
		</properties>
	</rule>
</ruleset>
